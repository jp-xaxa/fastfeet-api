generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DELIVERY_MAN
  ADMINISTRATOR
}

model User {
  id            String   @id @default(uuid())
  name          String
  cpf           String   @unique
  password      String
  role          UserRole @default(DELIVERY_MAN)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")

  orders        Order[] @relation("deliveryMan")

  @@map("users")
}

model Recipient {
  id              String   @id @default(uuid())
  name            String
  street          String
  neighborhood    String
  number          Int?
  complement      String?
  cep             String
  uf              String
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")

  orders          Order[]

  @@map("recipients")
}

model Order {
  id                String          @id @default(uuid())
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime?       @updatedAt @map("updated_at")
  waitingAt         DateTime?       @map("waiting_at")
  withdrawnAt       DateTime?       @map("withdrawn_at")
  deliveryAt        DateTime?       @map("delivery_at")
  recipientId       String          @map("recipient_id")
  deliveryManId     String?         @map("delivery_man_id")

  recipient         Recipient       @relation(fields: [recipientId], references: [id])
  deliveryMan       User?           @relation("deliveryMan", fields: [deliveryManId], references: [id])

  @@map("orders")
}
